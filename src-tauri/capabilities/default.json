{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default permissions for SlashBeacon desktop frontend",
  "windows": ["main"],
  "webviews": ["main"],
  "remote": {
    "urls": []
  },
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "href": "https://discord.com/**" },
        { "href": "https://*.discord.com/**" },
        { "href": "https://github.com/boredpolymath/slashbeacon/**" },
        { "href": "https://github.com/boredpolymath/truth-beacon/**" }
      ]
    },
    "updater:default"
  ]
}
